HTTP_PORT=8000
# Origin mà trình duyệt dùng — đổi HTTP_PORT thì đổi theo, vì URL ký ảnh chứa host này
PUBLIC_BASE_URL=http://localhost:8000
SEED_DEMO=true
# Hộp thư Gmail nhận thư của người dùng demo — bắt buộc khi SEED_DEMO=true
DEMO_MAILBOX=
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=asset_app
MINIO_APP_PASSWORD=
RABBITMQ_USER=asset
RABBITMQ_PASSWORD=
# Chuỗi ngẫu nhiên ≥ 32 byte
JWT_SECRET=
# Tài khoản Gmail của email-service — App Password, KHÔNG phải mật khẩu Gmail
MAIL_USERNAME=
MAIL_PASSWORD=