  "components" : {
    "schemas" : {
      "ApiErrorResponse" : {
        "description" : "Envelope for error response",
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ErrorCode"
          },
          "data" : {
            "$ref" : "#/components/schemas/ErrorDetail"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "data", "message" ]
      },
      "AttributeDataType" : {
        "type" : "string",
        "enum" : [ "TEXT", "NUMBER", "DATE", "BOOLEAN", "SELECT" ]
      },
      "AttributeDefinitionResponse" : {
        "type" : "object",
        "description" : "Response for attribute definition operations",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "dataType" : {
            "$ref" : "#/components/schemas/AttributeDataType"
          },
          "deadlineTracked" : {
            "type" : "boolean"
          },
          "displayOrder" : {
            "type" : "integer",
            "format" : "int32"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "label" : {
            "type" : "string"
          },
          "measureUnit" : {
            "type" : "string"
          },
          "options" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AttributeOptionResponse"
            }
          },
          "required" : {
            "type" : "boolean"
          },
          "status" : {
            "$ref" : "#/components/schemas/CatalogStatus"
          }
        },
        "required" : [ "code", "dataType", "deadlineTracked", "displayOrder", "id", "label", "options", "required", "status" ]
      },
      "AttributeOptionResponse" : {
        "type" : "object",
        "description" : "A selectable option for an attribute",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "label" ]
      },
      "CatalogStatus" : {
        "type" : "string",
        "enum" : [ "ACTIVE", "INACTIVE" ]
      },
      "ChangePasswordRequest" : {
        "type" : "object",
        "description" : "Request for changing user password",
        "properties" : {
          "confirmPassword" : {
            "type" : "string",
            "minLength" : 1
          },
          "currentPassword" : {
            "type" : "string",
            "minLength" : 1
          },
          "newPassword" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "confirmPassword", "currentPassword", "newPassword" ]
      },
      "DataScope" : {
        "type" : "string",
        "enum" : [ "SELF", "DEPARTMENT", "BRANCH", "ALL" ]
      },
      "EmailProbeRequest" : {
        "type" : "object",
        "description" : "Request for sending an email probe",
        "properties" : {
          "recipientEmail" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          },
          "recipientName" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "recipientEmail", "recipientName" ]
      },
      "ErrorCode" : {
        "type" : "string",
        "enum" : [ "VALIDATION_FAILED", "MALFORMED_REQUEST", "UNKNOWN_FIELD", "UNAUTHORIZED", "FORBIDDEN", "FIELD_GROUP_FORBIDDEN", "RESOURCE_NOT_FOUND", "METHOD_NOT_ALLOWED", "CONFLICT", "UNSUPPORTED_MEDIA_TYPE", "FILE_TOO_LARGE", "UNSUPPORTED_FILE_TYPE", "PASSWORD_SAME_AS_CURRENT", "INTERNAL_ERROR", "STORAGE_ERROR", "NOT_IMPLEMENTED" ]
      },
      "ErrorDetail" : {
        "properties" : {
          "error" : {
            "type" : "string"
          },
          "fieldErrors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldErrorDetail"
            }
          },
          "path" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "error", "path", "status", "timestamp" ]
      },
      "FieldErrorDetail" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "description" : "Request for user login",
        "properties" : {
          "password" : {
            "type" : "string",
            "minLength" : 1
          },
          "username" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "password", "username" ]
      },
      "LoginResponse" : {
        "type" : "object",
        "description" : "Response for login operations",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "mustChangePassword" : {
            "type" : "boolean"
          }
        },
        "required" : [ "accessToken", "mustChangePassword" ]
      },
      "MeResponse" : {
        "type" : "object",
        "description" : "Information for the currently authenticated user",
        "properties" : {
          "avatarUrl" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "fullName" : {
            "type" : "string"
          },
