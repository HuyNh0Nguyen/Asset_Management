  "components" : {
    "schemas" : {
      "ApiErrorResponse" : {
        "description" : "Envelope for error response",
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ErrorCode"
          },
          "data" : {
            "$ref" : "#/components/schemas/ErrorDetail"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "data", "message" ]
      },
      "AttributeDataType" : {
        "type" : "string",
        "enum" : [ "TEXT", "NUMBER", "DATE", "BOOLEAN", "SELECT" ]
      },
      "AttributeDefinitionResponse" : {
        "type" : "object",
        "description" : "Response for attribute definition operations",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "dataType" : {
            "$ref" : "#/components/schemas/AttributeDataType"
          },
          "deadlineTracked" : {
            "type" : "boolean"
          },
          "displayOrder" : {
            "type" : "integer",
            "format" : "int32"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "label" : {
            "type" : "string"
          },
          "measureUnit" : {
            "type" : "string"
          },
          "options" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AttributeOptionResponse"
            }
          },
          "required" : {
            "type" : "boolean"
          },
          "status" : {
            "$ref" : "#/components/schemas/CatalogStatus"
          }
        },
        "required" : [ "code", "dataType", "deadlineTracked", "displayOrder", "id", "label", "options", "required", "status" ]
      },
      "AttributeOptionResponse" : {
        "type" : "object",
        "description" : "A selectable option for an attribute",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "label" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "label" ]
      },
      "BlockingHeadResponse" : {
        "type" : "object",
        "description" : "Response indicating that the head of the organizational unit is blocking certain operations",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "head" : {
            "$ref" : "#/components/schemas/OrgUnitHeadResponse"
          },
          "name" : {
            "type" : "string"
          },
          "unitId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "code", "head", "name", "unitId" ]
      },
      "CatalogStatus" : {
        "type" : "string",
        "enum" : [ "ACTIVE", "INACTIVE" ]
      },
      "ChangePasswordRequest" : {
        "type" : "object",
        "description" : "Request for changing user password",
        "properties" : {
          "confirmPassword" : {
            "type" : "string",
            "minLength" : 1
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 8,
            "pattern" : "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9])[\\x21-\\x7E]+$"
          }
        },
        "required" : [ "confirmPassword", "newPassword" ]
      },
      "CreateOrgUnitRequest" : {
        "type" : "object",
        "description" : "Request payload for creating a new organizational unit",
        "properties" : {
          "code" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0,
            "pattern" : "^[A-Z0-9_]+$"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 255,
            "minLength" : 0
          },
          "parentId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "unitType" : {
            "$ref" : "#/components/schemas/OrgUnitType"
          }
        },
        "required" : [ "code", "name", "parentId", "unitType" ]
      },
      "CreateRankRequest" : {
        "type" : "object",
        "description" : "Request payload for creating a new rank",
        "properties" : {
          "code" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0,
            "pattern" : "^[A-Z0-9_]+$"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 255,
            "minLength" : 0
          },
          "seniority" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          }
        },
        "required" : [ "code", "name", "seniority" ]
      },
      "DataScope" : {
        "type" : "string",
        "enum" : [ "SELF", "DEPARTMENT", "BRANCH", "ALL" ]
      },
      "EmailProbeRequest" : {
        "type" : "object",
        "description" : "Request for sending an email probe",
        "properties" : {
          "recipientEmail" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          },
          "recipientName" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "recipientEmail", "recipientName" ]
      },
      "ErrorCode" : {
        "type" : "string",
        "enum" : [ "VALIDATION_FAILED", "MALFORMED_REQUEST", "UNKNOWN_FIELD", "UNAUTHORIZED", "INVALID_CREDENTIALS", "ACCOUNT_LOCKED", "ACCOUNT_DISABLED", "SESSION_EXPIRED", "FORBIDDEN", "FIELD_GROUP_FORBIDDEN", "PASSWORD_CHANGE_REQUIRED", "RESOURCE_NOT_FOUND", "METHOD_NOT_ALLOWED", "CONFLICT", "UNSUPPORTED_MEDIA_TYPE", "ORG_UNIT_CODE_DUPLICATE", "RANK_CODE_DUPLICATE", "RANK_SENIORITY_DUPLICATE", "FILE_TOO_LARGE", "UNSUPPORTED_FILE_TYPE", "PASSWORD_SAME_AS_CURRENT", "USER_NOT_ACTIVE", "ORG_UNIT_COMPANY_NOT_ALLOWED", "ORG_UNIT_INVALID_PARENT_TYPE", "ORG_UNIT_PARENT_CYCLE", "ORG_UNIT_PARENT_INACTIVE", "ORG_UNIT_ROOT_IMMUTABLE", "ORG_UNIT_HEAD_NOT_ACTIVE", "ORG_UNIT_HEAD_OUTSIDE_SUBTREE", "ORG_UNIT_MOVE_DETACHES_HEAD", "ORG_UNIT_NOT_EMPTY", "ORG_UNIT_IN_USE", "ORG_UNIT_INACTIVE", "ORG_UNIT_TYPE_NOT_ALLOWED", "RANK_IN_USE", "INTERNAL_ERROR", "STORAGE_ERROR", "NOT_IMPLEMENTED" ]
      },
      "ErrorDetail" : {
        "description" : "Error response with timestamp, status, error message, request path, and optional field errors",
        "properties" : {
          "error" : {
            "type" : "string"
          },
          "fieldErrors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldErrorDetail"
            }
          },
          "path" : {
            "type" : "string"
          },
          "retryAfterSeconds" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "timestamp" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "error", "path", "status", "timestamp" ]
      },
      "FieldErrorDetail" : {
        "description" : "Detail of a field validation error",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "description" : "Request for user login",
        "properties" : {
          "password" : {
            "type" : "string",
            "minLength" : 1
          },
          "username" : {
            "type" : "string",
            "minLength" : 1
          }
        },
