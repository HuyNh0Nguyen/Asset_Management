server {
    listen 80;
    client_max_body_size 10m;              # ảnh ≤ 5 MB (BR-51), tệp nhập ≤ 500 dòng (§4.1)

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};    # không có phần URI → giữ nguyên /api/...
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /asset-images/ {
        proxy_pass ${STORAGE_UPSTREAM};    # KHÔNG rewrite: đường dẫn là một phần của chữ ký
        proxy_set_header Host $http_host;  # $http_host giữ cả cổng — chữ ký có chứa Host
        proxy_buffering off;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}